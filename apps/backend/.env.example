# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pest_mantra

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins (the admin-web app)
CORS_ORIGINS=http://localhost:3000

# Bootstrap super admin (used only by seed script, then should be rotated)
SEED_SUPER_ADMIN_NAME=Pest Mantra Super Admin
SEED_SUPER_ADMIN_PHONE=9999999999
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345
