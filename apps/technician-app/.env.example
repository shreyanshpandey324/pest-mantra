# Base URL of the backend API (server-side only, never exposed to the browser)
BACKEND_API_URL=http://localhost:4000/api/v1

# Public origin of the backend, WITHOUT the /api/v1 suffix — used
# client-side to build absolute URLs for uploaded photos (served by
# the backend at /uploads/..., outside the /api/v1 namespace). Safe
# to expose: it's just a base URL, not a secret, unlike
# BACKEND_API_URL above.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# Must match the backend's JWT_ACCESS_SECRET so middleware can verify
# the access token's signature when protecting routes.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars

NODE_ENV=development
